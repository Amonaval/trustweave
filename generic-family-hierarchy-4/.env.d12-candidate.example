# D12 disposable candidate QA only.
# Copy this file to .env.d12-candidate. The real file is gitignored.
# NEVER paste or commit SUPABASE_SERVICE_ROLE_KEY.

QA_MODE=staging
QA_ALLOW_MUTATION=true
QA_STAGING_PROJECT_REF=yqtrkpyyzxzpthklqygs
QA_BASE_URL=http://127.0.0.1:3000
QA_EXTERNAL_SERVER=false

NEXT_PUBLIC_SUPABASE_URL=https://yqtrkpyyzxzpthklqygs.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<copy candidate anon/publishable-compatible key locally>
SUPABASE_SERVICE_ROLE_KEY=<copy candidate service_role key locally; never share>

# Deterministic disposable identities are created by qa:seed.
QA_RUN_NAMESPACE=d12
QA_EMAIL_DOMAIN=example.test
# QA_TEST_PASSWORD may be omitted; qa/setup/seed.mjs has a QA-only default.
