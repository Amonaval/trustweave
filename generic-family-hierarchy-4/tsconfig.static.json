{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "noEmit": true
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "app-shell/**/*.ts",
    "app-shell/**/*.tsx",
    "capabilities/**/*.ts",
    "capabilities/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "core/**/*.ts",
    "core/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "templates/**/*.ts",
    "templates/**/*.tsx",
    "verticals/**/*.ts",
    "verticals/**/*.tsx",
    "TemplateNetworkApp.tsx"
