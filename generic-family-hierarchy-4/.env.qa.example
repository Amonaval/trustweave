# Application under test
# Connected test verticals and roles are selected in top-level qa.config.mjs.
QA_BASE_URL=http://127.0.0.1:3000
QA_EXTERNAL_SERVER=true
QA_MODE=readonly
QA_ALLOW_MUTATION=false
# Keep false. Destructive QA must never run against production.
# The safety guard still recognizes this legacy override variable, but the certified path is staging-only.
QA_ALLOW_PRODUCTION=false
QA_RUN_NAMESPACE=local-cert

# Hosted Supabase mutations require this project ref to match NEXT_PUBLIC_SUPABASE_URL.
QA_STAGING_PROJECT_REF=

# Existing confirmed accounts. Use dedicated QA users, never personal accounts.
# In staging mutation mode qa:seed can create/fix these when left blank.
QA_OWNER_EMAIL=
QA_OWNER_PASSWORD=
QA_ADMIN_EMAIL=
QA_ADMIN_PASSWORD=
QA_MEMBER_EMAIL=
QA_MEMBER_PASSWORD=
QA_INVITEE_EMAIL=
QA_INVITEE_PASSWORD=

# Additional isolated tenant used by adversarial RLS/security certification.
QA_TENANT_B_OWNER_EMAIL=
QA_TENANT_B_OWNER_PASSWORD=

# Supabase public runtime config (required for role/API/RLS certification).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Staging-only automated identity/network bootstrap. Never use a production service-role key.
SUPABASE_SERVICE_ROLE_KEY=
QA_EMAIL_DOMAIN=example.test
QA_TEST_PASSWORD=TrustWeave-QA-Only-ChangeMe-123!

# Backward-compatible optional network IDs for existing/pre-seeded QA environments.
# Full staging `npm run qa:certify` uses deterministic qa:seed fixtures instead of relying on these IDs.
QA_FAMILY_NETWORK_ID=
QA_ALUMNI_NETWORK_ID=
QA_HOUSING_SOCIETY_NETWORK_ID=
QA_FAMILY_ASSOCIATION_NETWORK_ID=
QA_ASSOCIATION_NETWORK_ID=
QA_ORGANIZATION_NETWORK_ID=
QA_BUSINESS_TRUST_NETWORK_ID=
QA_FRANCHISE_NETWORK_ID=
QA_PROFESSIONAL_NETWORK_ID=

# PostgreSQL runtime migration certification.
# QA_DATABASE_URL: current protected staging DB; read-only audits may use it.
QA_DATABASE_URL=
# QA_FRESH_DATABASE_URL: disposable EMPTY Supabase DB used only for Phase 5B replay.
QA_FRESH_DATABASE_URL=
QA_DB_ALLOW_FRESH_REPLAY=false
# Historical upgrade/rerun window controls.
QA_DB_UPGRADE_CHECKPOINT=80
QA_DB_RERUN_FROM=90
# No PostgreSQL/psql installation is required. DB certification uses the project-local Node `pg` driver.

# Phase 5B — disposable fresh migration certification ONLY.
# QA_FRESH_PROJECT_REF and QA_FRESH_SUPABASE_URL are optional cross-checks.
# The runner derives the project ref from QA_FRESH_DATABASE_URL when possible.
QA_FRESH_PROJECT_REF=
QA_FRESH_SUPABASE_URL=
# Set exactly YES_DELETE_ME only after verifying this project is disposable and empty.
QA_FRESH_CONFIRM_DISPOSABLE=
QA_PHASE5B_CHECKPOINT=80
QA_PHASE5B_RERUN_FROM=90
