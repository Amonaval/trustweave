# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-only. Required for permanent network deletion so network-owned Supabase Storage objects can be removed via the Storage API.
# Never expose this as NEXT_PUBLIC_* and never use it in browser code.
SUPABASE_SERVICE_ROLE_KEY=
