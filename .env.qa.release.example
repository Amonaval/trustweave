# Phase 5C disposable release-candidate environment.
# Preferred setup: run `npm run qa:phase5c:init` after Phase 5B passes.
# That creates `.env.qa.release` with the disposable project ref/URL/DB URL prefilled.
# You must then fill ONLY the disposable project's anon + service-role keys and explicit confirmation.
QA_MODE=staging
QA_ALLOW_MUTATION=true
QA_RELEASE_ALLOW_MUTATION=true
QA_RELEASE_CONFIRM_DISPOSABLE=
QA_RELEASE_PROJECT_REF=
# Normal/staging project ref that Phase 5C must never target.
QA_RELEASE_PROTECTED_PROJECT_REF=
# Legacy mutation guard field: in this dedicated file it must equal QA_RELEASE_PROJECT_REF.
QA_STAGING_PROJECT_REF=
QA_BASE_URL=http://127.0.0.1:3000
QA_EXTERNAL_SERVER=false
QA_RELEASE_ALLOW_REMOTE_RC=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
QA_DATABASE_URL=
QA_EMAIL_DOMAIN=example.test
QA_TEST_PASSWORD=TrustWeave-QA-Only-ChangeMe-123!
QA_RUN_NAMESPACE=phase5c-release
